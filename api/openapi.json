      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Cancel Invoice",
        "operationId": "cancel_invoice_api_v1_invoices__invoice_id__cancel_post",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "title": "Invoice Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
