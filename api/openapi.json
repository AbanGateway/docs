            "title": "Iban"
          },
          "account_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Number"
          },
          "payment_url": {
            "type": "string",
            "title": "Payment Url"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "paid_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paid At"
          },
          "is_test": {
            "type": "boolean",
            "title": "Is Test"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "status",
          "amount_rial",
          "payable_rial",
          "payable_toman",
          "fee_rial",
          "order_id",
          "card_number",
          "card_holder",
          "card_last4",
          "iban",
          "account_number",
          "payment_url",
          "expires_at",
          "paid_at",
          "is_test"
        ],
        "title": "InvoiceResponse"
      },
