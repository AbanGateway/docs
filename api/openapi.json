        }
      }
    },
    "/api/v1/invoices/{invoice_id}/simulate-payment": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Simulate Payment",
        "description": "Mark a sandbox invoice paid, so an integration can be tested end to end.\n\nRefused outright for a live token. The competitor exposed the equivalent\nendpoint with no authentication at all, letting anyone mark any of their\nsandbox invoices paid.",
        "operationId": "simulate_payment_api_v1_invoices__invoice_id__simulate_payment_post",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "title": "Invoice Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
