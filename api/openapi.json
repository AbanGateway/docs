  "components": {
    "schemas": {
      "CreateInvoiceRequest": {
        "properties": {
          "amount_rial": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Rial",
            "description": "Amount in Rial"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url"
          },
          "return_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Url"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "expiry_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1440.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Minutes"
          },
          "channel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "instagram",
                  "telegram",
                  "in_person",
                  "website",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          }
        },
        "type": "object",
        "required": [
          "amount_rial"
        ],
        "title": "CreateInvoiceRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceResponse": {
        "properties": {
          "invoice_id": {
